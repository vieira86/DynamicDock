# Copy this file to ".env" (same folder as setup.py) to override backend
# settings without touching your system-wide environment variables. Every
# line is optional - only set what you actually need to change.

# Full path to the AutoDock Vina executable, if you don't want to use the
# one setup.py downloaded into vina/.
# VINA_EXECUTABLE=C:\path\to\vina.exe

# Full path to the Open Babel `obabel` executable. Useful if the pip-based
# install (openbabel-wheel) misbehaves on your machine and you installed
# Open Babel via conda instead, e.g.:
# OBABEL_EXECUTABLE=C:\Users\<you>\miniconda3\envs\obabel\Library\bin\obabel.exe

# Extra frontend origins allowed to call the API (comma-separated), on top
# of the defaults (localhost:3000 / 127.0.0.1:3000).
# DYNAMIC_DOCK_CORS_ORIGINS=http://localhost:5173

# Where docking results are written by default (when the frontend doesn't
# specify a folder).
# DYNAMIC_DOCK_RESULTS_DIR=C:\path\to\results
